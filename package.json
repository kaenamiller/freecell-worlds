{
  "name": "freecell-worlds",
  "version": "2.0.0",
  "description": "FreeCell Worlds — FreeCell in three.js with twenty-eight themed tables, spring-physics cards, positional sound, post-processing and a built-in solver.",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "gen:art": "node tools/gen-art.mjs && bash tools/optimize-assets.sh",
    "gen:sfx": "node tools/gen-sfx.mjs",
    "gen:music": "node tools/gen-sfx.mjs --music",
    "optimize": "bash tools/optimize-assets.sh"
  },
  "keywords": ["freecell", "solitaire", "three.js", "webgl", "game", "pwa"],
  "license": "MIT",
  "dependencies": {
    "three": "0.169.0"
  }
}
