# Copy to .dev.vars for `npm run dev`. The game (npm run serve) runs on :8080, the API on :8787.
BETTER_AUTH_URL=http://localhost:8787
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_DOMAIN=
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Cloudflare's always-pass Turnstile test secret; pairs with site key 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave RESEND_API_KEY empty to print account emails to the wrangler console.
RESEND_API_KEY=
EMAIL_FROM=FreeCell Worlds <onboarding@resend.dev>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
